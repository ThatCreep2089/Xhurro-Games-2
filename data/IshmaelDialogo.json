                "portrait": "ishmaelPortrait",
                "msgn": "No, compro otro igual."
                },
                {
                "speaker": "Navi",
                "portrait": "naviPortrait",
                "msgn": "¿Por qué?"
                },
                {
                "speaker": "Ishmael",
                "portrait": "ishmaelPortrait",
                "msgn": "Lo destruiría si lo intento desmontar."
                },
                {
                "speaker": "Navi",
                "portrait": "naviPortrait",
                "msgn": "..."
                }

			],
			"Rechazo": {
			    "speaker": "Ishmael",
			    "portrait": "ishmaelPortrait",
			    "msgn": "Es que, ¿has visto estos brazos?, lo toco y lo destruyo."
		    }
		},
        {
            "val": 3,
            "Dialog": [
