                "speaker": "Navi",
                "portrait": "naviPortrait",
                "msgn": "¿En serio?"
                },
                {
                "speaker": "Navi",
                "portrait": "naviPortrait",
                "msgn": "Lo iba a usar, ¿sabes?"
                }
            ],
			"Rechazo": {
			    "speaker": "Ishmael",
			    "portrait": "ishmaelPortrait",
			    "msgn": "*Besa el puzle de nuevo*"
		    }
        },
        {
            "val": 5,
            "Dialog": [
                {
                "speaker": "Navi",
                "portrait": "naviPortrait",
                "msgn": "¿Me ayudas con el puzle?"
                },
                {
                "speaker": "Ishmael",
                "portrait": "ishmaelPortrait",
                "msgn": "¿No sabes hacer ni si quiera el puzle más sencillo del mundo?"
                },
                {
                "speaker": "Navi",
                "portrait": "naviPortrait",
                "msgn": "..."
                },
                {
                "speaker": "Ishmael",
                "portrait": "ishmaelPortrait",
                "msgn": "Que pasa, ¿qué en tu tribu no hay puzles?"
                }

            ],
			"Rechazo": {
			    "speaker": "Ishmael",
			    "portrait": "ishmaelPortrait",
			    "msgn": "Si, eso pensaba yo."
		    }
        },
        {
			"val": 6,
			"Dialog": [
				{
				"speaker": "Navi",
				"portrait": "naviPortrait",
				"msgn": "Hola, ¿estás ahí?"
				},
				{
				"speaker": "Ishmael",
				"portrait": "ishmaelPortrait",
				"msgn": "¡Eh, hola! Justo a tiempo, estaba entrenando."
				},
				{
				"speaker": "Navi",
				"portrait": "naviPortrait",
				"msgn": "¿Entrenando?"
				},
				{
				"speaker": "Ishmael",
				"portrait": "ishmaelPortrait",
				"msgn": "Sí, mira estos brazos."
				},
				{
				"speaker": "Navi",
				"portrait": "naviPortrait",
				"msgn": "Vaya, sí que son grandes."
				},
				{
				"speaker": "Ishmael",
				"portrait": "ishmaelPortrait",
				"msgn": "¡Y fuertes! ¿Quieres ver?"
				},
				{
				"speaker": "Navi",
				"portrait": "naviPortrait",
				"msgn": "Bueno, vale..."
				},
				{
				"speaker": "Ishmael",
				"portrait": "ishmaelPortrait",
				"msgn": "¡TOMA!"
				},
				{
				"speaker": "Navi",
				"portrait": "naviPortrait",
				"msgn": "¡AHHHHHHHH!"
				},
				{
				"speaker": "Ishmael",
				"portrait": "ishmaelPortrait",
				"msgn": "¿Te ha gustado?"
				},
				{
				"speaker": "Navi",
				"portrait": "naviPortrait",
				"msgn": "¡Me has aplastado!"
				},
				{
				"speaker": "Ishmael",
				"portrait": "ishmaelPortrait",
				"msgn": "JEJEJEJEJEJE. Tranquilo, es solo práctica."
				},
				{
				"speaker": "Navi",
				"portrait": "naviPortrait",
				"msgn": "¿Práctica de qué?"
				},
                {
                "speaker": "Ishmael",
                "portrait": "ishmaelPortrait",
                "msgn": "..."
                },
                {
                "speaker": "Navi",
                "portrait": "naviPortrait",
                "msgn": "¿PRÁCTICA DE QUÉ?"
                }
            ],
			"Rechazo": {
			    "speaker": "Ishmael",
			    "portrait": "ishmaelPortrait",
			    "msgn": "*Flexea a Ish y a EL*"
		    }
        }
	]
	
